{
  "enabled": true,
  "name": "Build Docker Image",
  "description": "Builds the local AXERP Docker image using docker/Dockerfile. The .dockerignore excludes docs, CI configs, and branding source files to keep the build context small and fast.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "docker build -t axerp:local -f docker/Dockerfile .",
    "timeout": 300
  }
}